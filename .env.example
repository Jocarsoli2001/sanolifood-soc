COMPOSE_PROJECT_NAME=sanolifood
APP_NAME=SanoliFood Operations
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=UTC
LOG_LEVEL=INFO

POSTGRES_DB=sanolifood
POSTGRES_USER=sanolifood_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://sanolifood_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/sanolifood

PUBLIC_HTTP_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1

