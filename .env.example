COMPOSE_PROJECT_NAME=sanolifood
APP_NAME=SanoliFood Operations
APP_ENV=development
APP_VERSION=0.2.2
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=UTC
LOG_LEVEL=INFO
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
SESSION_MAX_AGE_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RUN_MIGRATIONS=true
RUN_SCHEMA_CHECK=true
RUN_BOOTSTRAP=true

BOOTSTRAP_ADMIN_USERNAME=admin.sanolifood
BOOTSTRAP_ADMIN_EMAIL=admin@sanolifood.local
BOOTSTRAP_ADMIN_FULL_NAME=Administrador SanoliFood
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_STRONG_PASSWORD

POSTGRES_DB=sanolifood
POSTGRES_USER=sanolifood_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://sanolifood_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/sanolifood

PUBLIC_HTTP_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
