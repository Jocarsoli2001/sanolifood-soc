<!-- Custom rule IDs 110000-110299 are reserved for SanoliFood SOC. -->
<group name="sanolifood,">
  <rule id="110000" level="3">
    <decoded_as>json</decoded_as>
    <field name="logger" type="pcre2">^sanolifood(?:\.|$)</field>
    <description>SanoliFood application telemetry event</description>
    <group>application,</group>
    <options>no_full_log</options>
  </rule>

  <rule id="110010" level="5">
    <if_sid>110000</if_sid>
    <field name="sf_event_type" type="pcre2">^auth\.login\.failed$</field>
    <description>SanoliFood authentication failure for $(actor_username) from $(source_ip)</description>
    <group>application,authentication_failed,</group>
  </rule>

  <rule id="110011" level="10" frequency="5" timeframe="120">
    <if_matched_sid>110010</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>Repeated SanoliFood authentication failures from $(source_ip)</description>
    <mitre>
      <id>T1110</id>
      <id>T1110.001</id>
    </mitre>
    <group>application,authentication_failures,attack,</group>
  </rule>

  <rule id="110012" level="9">
    <if_sid>110000</if_sid>
    <field name="sf_event_type" type="pcre2">^auth\.account\.locked$</field>
    <description>SanoliFood account locked after repeated authentication failures: $(actor_username)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>application,authentication_failures,account_lockout,</group>
  </rule>

  <rule id="110020" level="8">
    <if_sid>110000</if_sid>
    <field name="sf_event_type" type="pcre2">^inventory\.adjustment\.high_value$</field>
    <description>High-value SanoliFood inventory adjustment by $(actor_username)</description>
    <group>application,business_anomaly,inventory,</group>
  </rule>

  <rule id="110030" level="8">
    <if_sid>110000</if_sid>
    <field name="sf_event_type" type="pcre2">^quality\.check\.failed$</field>
    <description>SanoliFood quality check outside specification for resource $(resource_id)</description>
    <group>application,business_anomaly,quality,</group>
  </rule>

  <rule id="110040" level="12">
    <if_sid>110000</if_sid>
    <field name="sf_event_type" type="pcre2">^application\.error\.unhandled$</field>
    <description>Unhandled SanoliFood application error with correlation $(correlation_id)</description>
    <group>application,application_error,availability,</group>
  </rule>
  <rule id="110100" level="5">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^9900001$</field>
    <description>SanoliFood NDR end-to-end validation request from $(src_ip)</description>
    <group>suricata,network,ndr_validation,</group>
  </rule>

  <rule id="110110" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^9900002$</field>
    <description>SanoliFood NDR possible TCP service scan from $(src_ip) to $(dest_ip)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>suricata,network,network_scan,attack,</group>
  </rule>

  <rule id="110120" level="9">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^9900003$</field>
    <description>SanoliFood NDR sensitive web path enumeration from $(src_ip)</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
    <group>suricata,network,web_enumeration,reconnaissance,</group>
  </rule>

  <rule id="110130" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^9900004$</field>
    <description>SanoliFood NDR SQL injection indicator from $(src_ip) to $(dest_ip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>suricata,network,web_attack,initial_access,</group>
  </rule>

  <rule id="110140" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^9900005$</field>
    <description>SanoliFood NDR high-rate HTTP enumeration from $(src_ip)</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
    <group>suricata,network,web_enumeration,reconnaissance,</group>
  </rule>

  <rule id="110200" level="5">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)SanoliFoodEndpointValidation</field>
    <description>SanoliFood Windows Sysmon end-to-end validation process on $(win.system.computer)</description>
    <group>endpoint,windows,sysmon,edr_validation,</group>
  </rule>

  <rule id="110210" level="8">
    <if_sid>550,554</if_sid>
    <field name="file" type="pcre2">^/etc/sanolifood/(?:quality-policy|validation-probe)\.(?:yml|yaml)$</field>
    <description>SanoliFood Ubuntu quality configuration changed: $(file)</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <group>endpoint,linux,fim,configuration_change,quality,</group>
  </rule>

  <rule id="110211" level="8">
    <if_sid>550,554</if_sid>
    <field name="file" type="pcre2">(?i)^[A-Z]:\\SanoliFood\\Quality\\Config\\(?:quality-policy\.json|validation-probe\.txt)$</field>
    <description>SanoliFood Windows quality configuration changed: $(file)</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <group>endpoint,windows,fim,configuration_change,quality,</group>
  </rule>

  <rule id="110220" level="5">
    <program_name type="pcre2">^sanolifood-validation$</program_name>
    <match type="pcre2">endpoint-validation outcome=success</match>
    <description>SanoliFood Ubuntu endpoint log-collection validation</description>
    <group>endpoint,linux,logcollector,edr_validation,</group>
  </rule>
</group>
